{
    "name": "vt-parhomenko/olx-ua-api-sdk",
    "description": "OLX REST API sdk for php",
    "license": "MIT",
    "keywords": [
        "olx",
        "api",
        "sdk",
        "olx.ua",
        "olx.pl",
        "olx.ro",
        "olx.pt",
        "olx.bg",
        "olx.kz"
    ],
    "authors": [
        {
            "name": "Vitaliy Parhomenko",
            "email": "vt.parhomenko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Parhomenko\\Olx\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parhomenko\\Olx\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
